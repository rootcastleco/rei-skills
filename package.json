{
  "name": "rei-skills",
  "version": "6.2.0",
  "description": "The universal engineering-grade skill layer & Smart MCP Server for AI agents. 895 validated skills, 21 AI adapters, workflows & REI Reverse Engineering (REA).",
  "author": "Rootcastle Engineering & Innovation <admin@rootcastle.com> (https://rootcastle.com)",
  "homepage": "https://rootcastleco.github.io/rei-skills/",
  "license": "MIT",
  "scripts": {
    "validate": "python scripts/validate_skills.py",
    "validate:strict": "python scripts/validate_skills.py --strict --report data/quality-report.json",
    "validate:node": "node scripts/validate-skills.js",
    "validate:refs": "python scripts/validate_references.py",
    "index": "python scripts/generate_index.py",
    "readme": "python scripts/update_readme.py",
    "catalog": "node scripts/build-catalog.js",
    "doc-site": "node scripts/build-doc-site.js",
    "chain": "npm run validate:strict && npm run validate:node && npm run index && npm run catalog && npm run readme && npm run doc-site && npm run validate:refs",
    "build": "npm run chain",
    "test": "node scripts/tests/validate_skills_headings.test.js && python scripts/tests/test_validate_skills_headings.py && node scripts/tests/installer.test.js && node scripts/tests/mcp-safe-installer.test.js && npm run test:package",
    "test:network": "python scripts/tests/inspect_microsoft_repo.py && python scripts/tests/test_comprehensive_coverage.py",
    "brand": "node scripts/brand_skills.js",
    "security-audit": "node scripts/security_audit.js",
    "mcp": "node bin/mcp-server.js",
    "sync:rea": "python scripts/sync_rei_rea.py --sync",
    "check:rea": "python scripts/sync_rei_rea.py --check",
    "sync:microsoft": "python scripts/sync_microsoft_skills.py",
    "sync:all-official": "npm run sync:rea && npm run sync:microsoft && npm run build",
    "test:package": "node scripts/tests/npm-package.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootcastleco/rei-skills.git"
  },
  "bugs": {
    "url": "https://github.com/rootcastleco/rei-skills/issues"
  },
  "bin": {
    "rei-skills": "bin/install.js",
    "rei-skills-mcp": "bin/mcp-server.js"
  },
  "files": [
    "bin",
    "lib",
    "data",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rei-skills",
    "rootcastle",
    "ai-agents",
    "agent-skills",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "github-copilot",
    "windsurf",
    "antigravity",
    "opencode",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "reverse-engineering",
    "binary-analysis",
    "digital-forensics",
    "cybersecurity",
    "firmware-analysis",
    "developer-tools"
  ],
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
